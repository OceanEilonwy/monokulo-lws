#!/bin/sh /etc/rc.common
# shellcheck shell=ash
# shellcheck disable=SC2034,SC3043
# monokulo-lws, the Monero light wallet server. Its settings are in
# /etc/config/monokulo-lws, or LuCI: Services > Light Wallet Server. The
# server takes options on its command line, not a file, so each start
# turns the settings into one (`monokulo-lws serve --help` names them all);
# only what is set is passed, and the server's own defaults rule the rest.
#
# One server runs per network turned on (the network sections mainnet,
# stagenet and testnet), each a procd instance named after its network,
# with its own node, ports, data folder and admin key, and --network set
# so it refuses a node of another network. The settings in the main section
# are shared by all of them.
#
# Each server's admin API is always on, on this router alone (127.0.0.1),
# for the LuCI page: its key is made with the database at the first start
# and kept in /etc/monokulo-lws/secrets/<network>/, root's alone (the
# server keeps only its hash). A bad setting never stops a running server: a
# reload (a save in LuCI, `uci commit`) whose settings this script refuses
# for a network that runs leaves every server running on its earlier ones,
# and the reason is in /var/run/monokulo-lws/check (for every network) or
# check.<network> for LuCI to show. What a server itself refuses is in its
# log (logread).

START=99
STOP=10
USE_PROCD=1
EXTRA_COMMANDS="admin_key migrate"
EXTRA_HELP="	admin_key [network]	Make a new admin key for the LuCI page (stops and starts that network's server; mainnet by default)
	migrate	Turn settings from before networks had sections of their own into the network sections"

NAME=monokulo-lws
BIN=/usr/bin/monokulo-lws
RUN_AS=monokulo-lws
PAGE="Services > Light Wallet Server"
NETWORKS="mainnet stagenet testnet"
SECRETS_DIR=/etc/monokulo-lws/secrets
KEY_NAME=MONOKULO_LWS_ADMIN_KEY
# Where the one server's key was before each network had a server.
LEGACY_KEY_FILE=$SECRETS_DIR/$KEY_NAME
DEFAULT_DATA_DIR=/srv/monokulo-lws
DB_FILE=lws.sqlite
# Root's alone, in memory (rpcd.uc keeps its request bodies here too).
RUN_DIR=/var/run/monokulo-lws
# What the last start refused, for LuCI: for every network (check), or
# for one (check.<network>).
CHECK_FILE=$RUN_DIR/check
# Which build the package installed (its Makefile writes it).
VERSION_FILE=/usr/share/monokulo-lws/version

# The settings every network shares, passed through as they are:
# "<option> <UCI option> <kind>". value: --option VALUE. list: a UCI list,
# comma separated. repeat: the option once per entry of a UCI list. The
# node, the listeners, the database and the shader cache are each
# network's own, set apart.
OPTIONS='
--create create value
--import import value
--max-subaddresses max_subaddresses value
--lookahead lookahead value
--scan-interval scan_interval value
--tls-cert tls_cert value
--tls-key tls_key value
--trusted-proxies trusted_proxy list
--client-ip-header client_ip_header value
--access-control-origin access_control_origin repeat
--rate-limit rate_limit value
--strict-rate-limit strict_rate_limit value
--max-new-accounts-per-hour max_new_accounts_per_hour value
--max-pending-requests max_pending_requests value
--max-connections max_connections value
--max-connections-per-ip max_connections_per_ip value
--request-timeout request_timeout value
--catch-up-lanes catch_up_lanes value
--catch-up-join catch_up_join value
--catch-up-blocks catch_up_blocks value
--catch-up-in-flight catch_up_in_flight value
--gpu-arenas gpu_arenas value
--gpu-memory-mb gpu_memory_mb value
'

log() {
	logger -t "$NAME" "$*"
}

# run_dir: RUN_DIR made, root's alone.
run_dir() {
	mkdir -p "$RUN_DIR" && chmod 700 "$RUN_DIR"
}

# refuse <why>: a refusal for every network, logged, and kept for LuCI.
refuse() {
	log "$1"
	run_dir && printf '%s\n' "$1" >"$CHECK_FILE"
}

# refuse_net <network> <why>: a refusal for one network.
refuse_net() {
	log "$1: $2"
	run_dir && printf '%s\n' "$2" >"$CHECK_FILE.$1"
}

# is_network <name>: one of NETWORKS.
is_network() {
	case " $NETWORKS " in
	*" $1 "*) [ -n "$1" ] ;;
	*) return 1 ;;
	esac
}

# The --network option's name for a network section.
net_flag() {
	case "$1" in
	mainnet) echo main ;;
	stagenet) echo stage ;;
	testnet) echo test ;;
	esac
}

# net_default <network> <option>: a network's setting when its section
# leaves it out: its node's usual RPC port, and ports and a data folder
# apart from the other networks'.
net_default() {
	case "$1:$2" in
	mainnet:daemon) echo http://127.0.0.1:18081 ;;
	mainnet:port) echo 8443 ;;
	mainnet:admin_port) echo 8444 ;;
	mainnet:data_dir) echo "$DEFAULT_DATA_DIR" ;;
	stagenet:daemon) echo http://127.0.0.1:38081 ;;
	stagenet:port) echo 38443 ;;
	stagenet:admin_port) echo 38444 ;;
	stagenet:data_dir) echo "$DEFAULT_DATA_DIR-stagenet" ;;
	testnet:daemon) echo http://127.0.0.1:28081 ;;
	testnet:port) echo 28443 ;;
	testnet:admin_port) echo 28444 ;;
	testnet:data_dir) echo "$DEFAULT_DATA_DIR-testnet" ;;
	*:enabled) echo 0 ;;
	esac
}

# net_get <var> <network> <option>: the setting, or the network's default.
net_get() {
	config_get "$1" "$2" "$3" "$(net_default "$2" "$3")"
}

# Whether a network's server is on: the service's switch and its own.
net_enabled() {
	local on
	config_get_bool on "$1" enabled "$(net_default "$1" enabled)"
	[ "$on" = 1 ]
}

key_file() {
	echo "$SECRETS_DIR/$1/$KEY_NAME"
}

# Whether procd runs a network's server now (any network's, without one).
# Not procd_running, which would reset the service description
# start_service is in the middle of.
running_now() {
	local which='.*'
	[ -n "${1:-}" ] && which="['$1']"
	ubus call service list "{\"name\":\"$NAME\"}" 2>/dev/null |
		jsonfilter -q -e "@['$NAME'].instances$which.running" | grep -q true
}

# ---- settings from before each network had a section ------------------------

# legacy_network <network option> <node>: which network the one server of
# an older version served: its network guard if it had one, otherwise what
# its node says it is on, otherwise its node's port (monerod's defaults:
# 38081 stagenet, 28081 testnet), otherwise mainnet.
legacy_network() {
	local nettype
	case "$1" in
	main | mainnet) echo mainnet; return ;;
	stage | stagenet) echo stagenet; return ;;
	test | testnet) echo testnet; return ;;
	esac
	nettype=$(uclient-fetch -q -T 3 -O - \
		--post-data '{"jsonrpc":"2.0","id":"0","method":"get_info"}' "${2%/}/json_rpc" 2>/dev/null |
		jsonfilter -q -e '@.result.nettype')
	case "$nettype" in
	mainnet | stagenet | testnet) echo "$nettype"; return ;;
	esac
	case "$2" in
	*:38081 | *:38081/* | *:38089 | *:38089/*) echo stagenet ;;
	*:28081 | *:28081/* | *:28089 | *:28089/*) echo testnet ;;
	*) echo mainnet ;;
	esac
}

# migrate: settings an older version left (the node, ports and data folder
# in the main section, no network sections) turned into network sections,
# the old server's settings in its network's, which is on, the others off;
# and its admin key moved to that network's folder. Does nothing to
# settings that have network sections already, but for the key.
migrate() {
	local found=0 net=mainnet daemon port admin_port data_dir network n o
	config_load "$NAME"
	note_network() { found=1; }
	config_foreach note_network network
	if [ "$found" = 0 ]; then
		config_get daemon main daemon
		config_get port main port
		config_get admin_port main admin_port
		config_get data_dir main data_dir
		config_get network main network
		net=$(legacy_network "$network" "${daemon:-$(net_default mainnet daemon)}")
		for n in $NETWORKS; do
			uci -q set "$NAME.$n=network"
			uci -q set "$NAME.$n.enabled=0"
			for o in daemon port admin_port data_dir; do
				uci -q set "$NAME.$n.$o=$(net_default "$n" "$o")"
			done
		done
		uci -q set "$NAME.$net.enabled=1"
		# The old server's settings go to its network: its data folder too,
		# so the database it made stays its own.
		[ -n "$daemon" ] && uci -q set "$NAME.$net.daemon=$daemon"
		[ -n "$port" ] && uci -q set "$NAME.$net.port=$port"
		[ -n "$admin_port" ] && uci -q set "$NAME.$net.admin_port=$admin_port"
		uci -q set "$NAME.$net.data_dir=${data_dir:-$DEFAULT_DATA_DIR}"
		for o in daemon port admin_port data_dir network; do
			uci -q delete "$NAME.main.$o"
		done
		uci -q commit "$NAME"
		log "moved the settings to the network section $net (the node is on $net), and made the other networks' sections, off: turn them on in $PAGE"
		config_load "$NAME"
	else
		# Settings that had network sections already (a new package's
		# settings over an old install, say): the old key belongs to the
		# network whose data folder holds the database it was made with.
		for n in $NETWORKS; do
			net_get data_dir "$n" data_dir
			if [ "${data_dir%/}" = "$DEFAULT_DATA_DIR" ]; then
				net=$n
				break
			fi
		done
	fi
	if [ -s "$LEGACY_KEY_FILE" ] && [ ! -e "$(key_file "$net")" ]; then
		mkdir -p "$SECRETS_DIR/$net" && chmod 700 "$SECRETS_DIR/$net" &&
			mv "$LEGACY_KEY_FILE" "$(key_file "$net")" &&
			log "moved the admin key to $(key_file "$net")"
	fi
	return 0
}

# ---- the checks --------------------------------------------------------------

# The address to listen on: this router's, the LAN's or every interface's.
listen_addr() {
	local addr
	case "$1" in
	all) addr=0.0.0.0 ;;
	loopback) addr=127.0.0.1 ;;
	lan)
		. /lib/functions/network.sh
		network_get_ipaddr addr lan || return 1
		;;
	*) return 1 ;;
	esac
	echo "$addr"
}

# dir_refusal <dir>: why the folder can't be a data folder, if it is a
# system folder or in one, a top-level folder, or in memory; fails if it
# can be. Root makes the data folder the server's user's, so it must never
# be one the system or root relies on. LuCI's page checks the same.
dir_refusal() {
	case "$1" in
	/tmp | /tmp/* | /var | /var/*)
		echo "the data folder $1 is in memory and would be lost on reboot: choose one on storage in $PAGE"
		;;
	/ | /etc | /etc/* | /root | /root/* | /usr | /usr/* | /bin | /bin/* | /sbin | /sbin/* | \
		/lib | /lib/* | /lib64 | /lib64/* | /proc | /proc/* | /sys | /sys/* | /dev | /dev/* | \
		/www | /www/* | /rom | /rom/* | /overlay | /overlay/*)
		echo "not using the data folder $1: it is a system folder or in one; choose a folder of its own, such as $DEFAULT_DATA_DIR, in $PAGE"
		;;
	/*/*) return 1 ;;
	*)
		echo "not using the data folder $1: choose a folder of its own inside another, such as $DEFAULT_DATA_DIR, in $PAGE"
		;;
	esac
}

# Use the data folder only if it is the server's own: new, empty, or
# already owned by its user, and not a system folder. Never take over some
# other directory, and never reach, as root, into what the server's user
# may change: only the folder itself is chowned, never what it holds (the
# server's user makes its own files there). A refusal says why on stdout.
prepare_data_dir() {
	local dir real why
	# One spelling: no trailing slash, no '.' or '..' parts, no '//', so the
	# checks see the folder that is used.
	dir=$(printf '%s' "$1" | sed 's:/*$::')
	[ -n "$dir" ] || dir=/
	case "$dir" in
	/*) ;;
	*) echo "the data folder must be an absolute path, not '$1'"; return 1 ;;
	esac
	case "$dir/" in
	*//* | */./* | */../*) echo "the data folder must be a plain path, without '.', '..' or '//': not '$1'"; return 1 ;;
	esac
	why=$(dir_refusal "$dir") && { echo "$why"; return 1; }
	[ -e "$dir" ] || [ -L "$dir" ] || mkdir -p "$dir" || return 1
	if [ -L "$dir" ]; then
		echo "not using the data folder $dir: it is a symbolic link; name the folder itself in $PAGE"
		return 1
	fi
	if [ ! -d "$dir" ]; then
		echo "the data folder $dir is not a folder: choose another in $PAGE"
		return 1
	fi
	# A link higher up the path (/srv on a USB disk, say) is fine, as long
	# as the folder it leads to passes the same checks.
	real=$(readlink -f "$dir") || return 1
	why=$(dir_refusal "$real") && { echo "$why (it is $real)"; return 1; }
	if [ "$(ls -ldn "$dir" | awk '{ print $3 }')" != "$(id -u "$RUN_AS")" ]; then
		if [ -n "$(ls -A "$dir")" ]; then
			echo "not using the data folder $dir: it holds other files and isn't $NAME's own; choose a new or empty folder in $PAGE"
			return 1
		fi
		chown -h "$RUN_AS:$RUN_AS" "$dir" || return 1
	fi
	chmod 700 "$dir"
}

# give_file <file>: a file root put in a data folder (a TLS certificate
# or key, as the page suggests) made the server's, so it can read it. Only
# a plain file, not a link (symbolic or hard), and only if root's: never
# hand over a file reached through something the server's user controls.
give_file() {
	[ -f "$1" ] && [ ! -L "$1" ] || return 0
	# ls -ln: the mode, the number of links, the owner's uid.
	[ "$(ls -ln "$1" | awk '{ print $2, $3 }')" = "1 0" ] || return 0
	chown -h "$RUN_AS:$RUN_AS" "$1"
}

# ensure_admin_key <db> <key file>: the admin key for the LuCI page, made
# with the database (the server keeps its hash there) and kept root's
# alone. Made again when the database is new: a key the database doesn't
# know is no use. The server must not be running (the database is written).
ensure_admin_key() {
	local db="$1" key_file="$2" key_dir key
	key_dir=${key_file%/*}
	mkdir -p "$key_dir" || return 1
	chown root:root "${SECRETS_DIR%/*}" "$SECRETS_DIR" "$key_dir"
	chmod 700 "${SECRETS_DIR%/*}" "$SECRETS_DIR" "$key_dir"
	if [ -L "$db" ]; then
		echo "not using the database $db: it is a symbolic link"
		return 1
	fi
	if [ ! -s "$db" ] || [ ! -s "$key_file" ]; then
		# Made as the server's user, who owns the data folder and so what
		# the path leads to; only the printed key comes back to root. The
		# pid file is never written: it keeps start-stop-daemon from
		# refusing because the server itself runs (-x alone matches it).
		run_dir || return 1
		key=$(start-stop-daemon -S -c "$RUN_AS" -p "$RUN_DIR/create-key.pid" \
			-x "$BIN" -- admin create-key --db "$db" 2>/dev/null) || {
			echo "couldn't make an admin key in $db: logread -e $NAME says why"
			return 1
		}
		case "$key" in
		*[!0-9a-f]* | '') echo "couldn't make an admin key: the server printed something else"; return 1 ;;
		esac
		(
			umask 077
			printf '%s\n' "$key" >"$key_file.new"
		) && mv "$key_file.new" "$key_file" || return 1
		log "made the admin key for $PAGE, $key_file"
	fi
	chown root:root "$key_file"
	chmod 600 "$key_file"
}

# append_options: the shared settings of OPTIONS that are set, onto the command.
append_option() {
	procd_append_param command "$2" "$1"
}
append_options() {
	local option name kind value
	while read -r option name kind; do
		[ -n "$option" ] || continue
		case "$kind" in
		repeat)
			config_list_foreach main "$name" append_option "$option"
			;;
		list)
			config_get value main "$name"
			[ -n "$value" ] && procd_append_param command "$option" "$(echo "$value" | sed 's/  */,/g')"
			;;
		*)
			config_get value main "$name"
			[ -n "$value" ] && procd_append_param command "$option" "$value"
			;;
		esac
	done <<-EOF
		$OPTIONS
	EOF
}

# The networks turned on, in NETWORKS' order.
enabled_networks() {
	local n
	for n in $NETWORKS; do
		net_enabled "$n" && echo "$n"
	done
}

# prepare_shared: reads the shared settings (config_load first) into the
# variables every instance is made from, and checks that the networks
# turned on don't share a port or a data folder; succeeds, or sets REASON
# and fails. WAITING=1 marks a LAN address not there yet, which isn't a
# refusal: the interface trigger starts it.
prepare_shared() {
	local tls_cert tls_key n p other port admin_port dir seen_ports seen_dirs
	REASON=
	WAITING=0
	config_get LISTEN main listen loopback
	config_get LOG_LEVEL main log_level info
	config_get NICE main nice 10
	config_get CPUS main cpus
	config_get tls_cert main tls_cert
	config_get tls_key main tls_key
	TLS_FILES="$tls_cert $tls_key"

	case "$LISTEN" in
	all | loopback | lan) ;;
	*)
		REASON="listen must be loopback, lan or all, not '$LISTEN'"
		return 1
		;;
	esac
	if [ -n "$tls_cert$tls_key" ]; then
		if [ ! -s "$tls_cert" ] || [ ! -s "$tls_key" ]; then
			REASON="TLS needs both files on this router, the certificate chain '$tls_cert' and the key '$tls_key'; a data folder is a good place for them"
			return 1
		fi
	fi

	# Every port and data folder of the networks turned on, once.
	seen_ports=
	seen_dirs=
	for n in $(enabled_networks); do
		net_get port "$n" port
		net_get admin_port "$n" admin_port
		for p in "$port" "$admin_port"; do
			case "$p" in
			*[!0-9]* | '')
				REASON="$n's ports must be numbers: port '$port', admin_port '$admin_port'"
				return 1
				;;
			esac
			other=$(printf '%s\n' "$seen_ports" | awk -v p="$p" '$1 == p { print $2; exit }')
			if [ -n "$other" ]; then
				if [ "$other" = "$n" ]; then
					REASON="$n's admin API needs a port of its own, not its wallet API's $p"
				else
					REASON="$n and $other both use the port $p: each network needs ports of its own"
				fi
				return 1
			fi
			seen_ports="$seen_ports
$p $n"
		done
		net_get dir "$n" data_dir
		dir=$(printf '%s' "$dir" | sed 's:/*$::')
		other=$(printf '%s\n' "$seen_dirs" | awk -v d="$dir" '
			$1 != "" && ($1 == d || index(d, $1 "/") == 1 || index($1, d "/") == 1) { print $2; exit }')
		if [ -n "$other" ]; then
			REASON="$n and $other share the data folder $dir, or one is inside the other: each network needs a folder of its own"
			return 1
		fi
		seen_dirs="$seen_dirs
$dir $n"
	done

	if ! ADDR=$(listen_addr "$LISTEN"); then
		WAITING=1
		REASON="waiting for the lan interface's address: it starts once the LAN is up"
		return 1
	fi

	# The scanner's CPUs, as taskset takes them; a list this router can't
	# honour is dropped. Its niceness, 0 to 19.
	if [ -n "$CPUS" ] && ! taskset -c "$CPUS" true 2>/dev/null; then
		log "can't keep the servers to CPUs '$CPUS' (no such CPUs here); they may use all of them"
		CPUS=
	fi
	case "$NICE" in
	'' | *[!0-9]*) NICE=0 ;;
	esac
	[ "$NICE" -le 19 ] || NICE=19
	return 0
}

# prepare_net <network>: reads a network's settings into the variables its
# instance is made from, readies its data folder and admin key, and
# succeeds; or sets REASON and fails. After prepare_shared.
prepare_net() {
	local net="$1" f
	REASON=
	net_get DAEMON "$net" daemon
	net_get PORT "$net" port
	net_get ADMIN_PORT "$net" admin_port
	net_get DATA_DIR "$net" data_dir
	DATA_DIR=$(printf '%s' "$DATA_DIR" | sed 's:/*$::')
	DB=$DATA_DIR/$DB_FILE
	KEY_FILE=$(key_file "$net")

	case "$DAEMON" in
	http://?* | https://?*) ;;
	*)
		REASON="the node must be an address such as $(net_default "$net" daemon), not '$DAEMON'"
		return 1
		;;
	esac
	REASON=$(prepare_data_dir "$DATA_DIR" 2>&1) || return 1
	REASON=$(ensure_admin_key "$DB" "$KEY_FILE" 2>&1) || return 1
	# TLS files root put in this data folder, for the server to read.
	for f in $TLS_FILES; do
		[ "${f%/*}" = "$DATA_DIR" ] && give_file "$f"
	done
	return 0
}

# open_instance <network>: its server, from what prepare_shared and
# prepare_net read.
open_instance() {
	local net="$1"
	procd_open_instance "$net"
	if [ -n "$CPUS" ]; then
		procd_set_param command taskset -c "$CPUS" "$BIN"
	else
		procd_set_param command "$BIN"
	fi
	procd_append_param command serve \
		--daemon "$DAEMON" \
		--network "$(net_flag "$net")" \
		--db "$DB" \
		--cache-dir "$DATA_DIR/cache" \
		--listen "$ADDR:$PORT" \
		--admin-listen "127.0.0.1:$ADMIN_PORT"
	# Listening anywhere but loopback is the operator's choice (listen),
	# made with TLS or a proxy in front, as the page says.
	[ "$ADDR" = 127.0.0.1 ] || procd_append_param command --confirm-external-bind
	append_options
	procd_set_param env RUST_LOG="$LOG_LEVEL"
	procd_set_param user "$RUN_AS"
	procd_set_param nice "$NICE"
	# No core dumps: one would hold every account's private view key.
	procd_set_param limits core="0"
	# The build, kept with the instance so LuCI reports the one running,
	# not only the one installed. A new build changes it, as new settings
	# change the command line, so procd restarts the instance onto them.
	procd_set_param data \
		version="$(sed -n 's/^version=//p' "$VERSION_FILE" 2>/dev/null)" \
		commit="$(sed -n 's/^commit=//p' "$VERSION_FILE" 2>/dev/null)"
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

start_service() {
	local enabled net failed=0

	# Each start says afresh what refuses it.
	rm -f "$CHECK_FILE" "$CHECK_FILE".*
	migrate
	config_get_bool enabled main enabled 1
	[ "$enabled" = 1 ] || return 0

	if ! prepare_shared; then
		if [ "$WAITING" = 1 ]; then
			log "$REASON"
			return 0
		fi
		refuse "$REASON"
		return 1
	fi

	# Each network on its own: one refused doesn't keep the others from
	# starting.
	for net in $(enabled_networks); do
		if prepare_net "$net"; then
			open_instance "$net"
		else
			refuse_net "$net" "$REASON"
			failed=1
		fi
	done
	return $failed
}

# A reload (a save in LuCI, `uci commit`, the LAN coming up) keeps every
# server on its last good settings if the new ones are refused here for a
# network whose server runs; a start (a restart's included) doesn't start
# the networks refused.
reload_service() {
	local enabled net keep=0
	migrate
	config_get_bool enabled main enabled 1
	if [ "$enabled" = 1 ] && running_now; then
		if ! prepare_shared; then
			if [ "$WAITING" = 0 ]; then
				refuse "$REASON"
				keep=1
			fi
		else
			for net in $(enabled_networks); do
				if ! prepare_net "$net" && running_now "$net"; then
					refuse_net "$net" "$REASON"
					keep=1
				fi
			done
		fi
		if [ "$keep" = 1 ]; then
			log "keeps running on its earlier settings"
			return 0
		fi
	fi
	start
}

service_triggers() {
	procd_add_reload_trigger "$NAME"
	# In "LAN only" mode the listen address follows the LAN interface.
	procd_add_interface_trigger "interface.*.up" lan "/etc/init.d/$NAME" reload
}

# admin_key [network]: a new admin key for the LuCI page, for a database
# that doesn't know the key in the secrets folder any more (restored from a
# backup, say): that network's server is stopped while the key is made, and
# started again.
admin_key() {
	local net="${1:-mainnet}" data_dir i=0
	if ! is_network "$net"; then
		echo "the network is one of $NETWORKS, not '$net'" >&2
		return 1
	fi
	migrate
	net_get data_dir "$net" data_dir
	if ! REASON=$(prepare_data_dir "$data_dir" 2>&1); then
		log "$REASON"
		echo "$REASON" >&2
		return 1
	fi
	stop "$net"
	while running_now "$net" && [ $i -lt 15 ]; do
		sleep 1
		i=$((i + 1))
	done
	rm -f "$(key_file "$net")"
	if ! REASON=$(ensure_admin_key "${data_dir%/}/$DB_FILE" "$(key_file "$net")" 2>&1); then
		log "$REASON"
		echo "$REASON" >&2
		start
		return 1
	fi
	start
}
