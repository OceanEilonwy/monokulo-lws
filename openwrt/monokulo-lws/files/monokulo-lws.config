config monokulo-lws 'main'
	option enabled '1'
	# monerod's RPC address: your own node, which the server trusts.
	option daemon 'http://127.0.0.1:18081'
	# The wallet API's port, and where it listens: 'loopback' (127.0.0.1,
	# for a TLS proxy on this router in front of it), 'lan' or 'all'. Off
	# loopback, set tls_cert and tls_key or put a proxy in front: every
	# request carries a view key.
	option port '8443'
	option listen 'loopback'
	# The admin API, on 127.0.0.1 alone, for the LuCI page; its key is in
	# /etc/monokulo-lws/secrets/.
	option admin_port '8444'
	# The database (every wallet's view key) and the shader cache. Must be
	# on storage, not /tmp. Kept across firmware upgrades if left here.
	option data_dir '/srv/monokulo-lws'
	# How much the server logs (logread): error, warn, info, debug, trace.
	option log_level 'info'
	# The server's nice level, 0 (normal) to 19 (lowest priority), so that
	# catching up with the chain leaves the router's CPU for routing; and
	# the CPUs it may use, as taskset takes them (e.g. '2,3'; empty: all).
	option nice '10'
	# Every other setting is the server's own default until set here or in
	# LuCI (Services > Light Wallet Server). `monokulo-lws serve --help`
	# describes them: network, create, import, max_subaddresses, lookahead,
	# scan_interval, tls_cert, tls_key, trusted_proxy (a list),
	# client_ip_header, access_control_origin (a list), rate_limit,
	# strict_rate_limit, max_new_accounts_per_hour, max_pending_requests,
	# max_connections, max_connections_per_ip, request_timeout,
	# catch_up_lanes, catch_up_join, catch_up_blocks, catch_up_in_flight,
	# gpu_arenas, gpu_memory_mb.
