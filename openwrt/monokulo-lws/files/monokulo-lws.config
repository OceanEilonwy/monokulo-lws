config monokulo-lws 'main'
	# The switch for the whole service: off stops every network below.
	option enabled '1'
	# Where the wallet APIs listen: 'loopback' (127.0.0.1, for a TLS proxy
	# on this router in front of them), 'lan' or 'all'. Off loopback, set
	# tls_cert and tls_key or put a proxy in front: every request carries a
	# view key.
	option listen 'loopback'
	# How much the servers log (logread): error, warn, info, debug, trace.
	option log_level 'info'
	# The servers' nice level, 0 (normal) to 19 (lowest priority), so that
	# catching up with the chain leaves the router's CPU for routing; and
	# the CPUs they may use, as taskset takes them (e.g. '2,3'; empty: all).
	option nice '10'
	# Every other setting here is shared by every network, and is the
	# server's own default until set here or in LuCI (Services > Light
	# Wallet Server). `monokulo-lws serve --help` describes them: create,
	# import, max_subaddresses, lookahead, scan_interval, tls_cert, tls_key,
	# trusted_proxy (a list), client_ip_header, access_control_origin (a
	# list), rate_limit, strict_rate_limit, max_new_accounts_per_hour,
	# max_pending_requests, max_connections, max_connections_per_ip,
	# request_timeout, catch_up_lanes, catch_up_join, catch_up_blocks,
	# catch_up_in_flight, gpu_arenas, gpu_memory_mb.

# One server per network, each turned on by its own switch, with its own
# node, ports, database and admin key. The section's name is the network:
# the server refuses to start on a node of another one. Each needs ports of
# its own and a data folder of its own (the database, every wallet's view
# key; the shader cache), on storage, not /tmp.
config network 'mainnet'
	option enabled '1'
	# monerod's RPC address: your own node, which the server trusts.
	option daemon 'http://127.0.0.1:18081'
	# The wallet API's port, and the admin API's, on 127.0.0.1 alone, for
	# the LuCI page; its key is in /etc/monokulo-lws/secrets/mainnet/.
	option port '8443'
	option admin_port '8444'
	option data_dir '/srv/monokulo-lws'

config network 'stagenet'
	option enabled '0'
	option daemon 'http://127.0.0.1:38081'
	option port '38443'
	option admin_port '38444'
	option data_dir '/srv/monokulo-lws-stagenet'

config network 'testnet'
	option enabled '0'
	option daemon 'http://127.0.0.1:28081'
	option port '28443'
	option admin_port '28444'
	option data_dir '/srv/monokulo-lws-testnet'
